{
  "name": "wtagent-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop IDE for WTAgent — AI coding agent, workspace editor and terminal.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "com.wtagent.studio",
    "productName": "WTAgent Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "wtagent/src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../node_modules",
        "to": "wtagent/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../package.json",
        "to": "wtagent/package.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "WTAgent-Studio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
